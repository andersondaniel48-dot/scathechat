// Red mist: the moment a round connects. A burst of blood spray and droplets against a dark wall.
uniform float2 iResolution;
uniform float iTime;
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float aspect = iResolution.x / iResolution.y;
    float cyc = fract(iTime / 3.0);
    float3 col = concrete(uv * 1.6) * 0.5;
    float2 c = float2(aspect * 0.62, 0.45);
    float2 dir = normalize(float2(1.0, -0.15));
    float2 d = uv - c; float r = length(d);
    float fwd = dot(d / (r + 1e-4), dir);
    float grow = 1.0 - pow(1.0 - clamp(cyc / 0.25, 0.0, 1.0), 2.0);
    float fade = 1.0 - smoothstep(0.55, 1.0, cyc);
    // spray cone of fine mist
    float cone = smoothstep(-0.1, 0.8, fwd) * smoothstep(1.3 * grow + 0.02, 0.0, r);
    float mist = cone * (fbm(uv * 22.0 - dir * cyc * 8.0) * 1.4 + 0.25);
    col = mix(col, float3(0.5, 0.02, 0.03), clamp(mist, 0.0, 1.0) * 0.8 * fade);
    // the stain it leaves on the wall (persists)
    float st = splat(uv, c + dir * 0.1, 0.2, 2.0, 0.3 + 0.7 * smoothstep(0.3, 1.0, cyc), dir) * smoothstep(0.05, 0.3, cyc);
    float e = 1.0 / iResolution.y;
    float stx = splat(uv + float2(e, 0.0), c + dir * 0.1, 0.2, 2.0, 0.3 + 0.7 * smoothstep(0.3, 1.0, cyc), dir) * smoothstep(0.05, 0.3, cyc);
    col = shadeBlood(col, st, (stx - st) / e * 0.004, 0.0);
    // flying droplets
    for (int i = 0; i < 40; i++) {
        float fi = float(i);
        float a = atan(dir.y, dir.x) + (hash21(float2(fi, 1.0)) - 0.5) * 1.3;
        float2 u = float2(cos(a), sin(a));
        float sp = 0.4 + 1.2 * hash21(float2(fi, 2.0));
        float2 p = c + u * sp * grow * 0.9 + float2(0.0, cyc * cyc * 0.5);
        float s = 0.005 + 0.012 * hash21(float2(fi, 3.0));
        col = mix(col, float3(0.4, 0.0, 0.02), smoothstep(s, s * 0.5, length(uv - p)) * fade);
    }
    // muzzle-white impact flash
    col += float3(1.0, 0.85, 0.75) * smoothstep(0.05, 0.0, cyc) * smoothstep(0.25, 0.0, r);
    return half4(col, 1.0);
}
