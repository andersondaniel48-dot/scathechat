// Night firefight: tracers crossing a smoke-choked sky, muzzle flashes on the ridgeline, flares.
uniform float2 iResolution;
uniform float iTime;
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float aspect = iResolution.x / iResolution.y;
    float t = iTime;
    float sm = fbm(uv * float2(1.5, 3.0) + float2(t * 0.03, 0.0));
    float3 col = mix(float3(0.01, 0.012, 0.018), float3(0.07, 0.06, 0.06), sm * smoothstep(1.0, 0.2, uv.y));
    // parachute flare lighting the smoke
    float2 fl = float2(aspect * 0.25 + sin(t * 0.2) * 0.1, 0.18 + fract(t * 0.03) * 0.25);
    col += float3(1.0, 0.45, 0.25) * 0.08 / (0.02 + length(uv - fl)) * (0.3 + 0.7 * sm);
    col += float3(1.0, 0.8, 0.6) * smoothstep(0.012, 0.0, length(uv - fl));
    // ridgeline
    float ridge = 0.78 + 0.08 * fbm3(float2(uv.x * 2.0, 3.0));
    float rm = smoothstep(ridge - 0.004, ridge + 0.004, uv.y);
    col = mix(col, float3(0.008, 0.008, 0.01), rm);
    // tracers
    for (int i = 0; i < 26; i++) {
        float fi = float(i);
        float sp = 0.35 + 0.5 * hash21(float2(fi, 1.0));
        float ph = fract(t * sp + hash21(float2(fi, 2.0)));
        float2 a = float2(aspect * hash21(float2(fi, 3.0)), 0.8);
        float ang = -1.2 - 0.6 * hash21(float2(fi, 4.0)) + (hash21(float2(fi, 5.0)) < 0.5 ? 0.0 : -0.9);
        float2 u = float2(cos(ang), sin(ang));
        if (hash21(float2(fi, 6.0)) < 0.5) u.x = -u.x;
        float2 head = a + u * ph * 1.6;
        float2 tail = head - u * 0.12;
        float dd = segDist(uv, tail, head);
        float3 tc = hash21(float2(fi, 7.0)) < 0.35 ? float3(0.4, 1.0, 0.4) : float3(1.0, 0.35, 0.12);
        col += tc * (smoothstep(0.006, 0.0, dd) * 1.4 + 0.003 / (dd + 0.003) * 0.25) * (1.0 - rm);
        // muzzle flash at the origin as the round leaves
        col += float3(1.0, 0.7, 0.3) * smoothstep(0.05, 0.0, ph) * 0.004 / (length(uv - a) + 0.004);
    }
    // distant artillery lighting the horizon
    float boom = pow(max(sin(t * 1.3) * sin(t * 0.7 + 1.0), 0.0), 8.0);
    col += float3(1.0, 0.5, 0.2) * boom * 0.35 * smoothstep(0.45, 0.8, uv.y) * (1.0 - rm) * smoothstep(0.6, 0.0, abs(uv.x - aspect * 0.7));
    col += (hash21(fragCoord + floor(t * 30.0)) - 0.5) * 0.02;
    return half4(col, 1.0);
}
