// Thermal scope: white-hot target through the glass, cold background, sensor noise and scan lines.
uniform float2 iResolution;
uniform float iTime;
float capsule(float2 p, float2 a, float2 b, float r) { return segDist(p, a, b) - r; }
float3 iron(float t) {
    t = clamp(t, 0.0, 1.0);
    float3 c = mix(float3(0.02, 0.0, 0.08), float3(0.35, 0.0, 0.5), smoothstep(0.0, 0.3, t));
    c = mix(c, float3(0.85, 0.15, 0.1), smoothstep(0.25, 0.55, t));
    c = mix(c, float3(1.0, 0.65, 0.05), smoothstep(0.5, 0.8, t));
    return mix(c, float3(1.0, 1.0, 0.85), smoothstep(0.8, 1.0, t));
}
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float aspect = iResolution.x / iResolution.y;
    float t = iTime;
    float bg = 0.12 + 0.18 * fbm(uv * 3.0 + float2(t * 0.02, 0.0)) + 0.05 * vnoise(uv * 40.0);
    // a soldier with helmet and rifle, walking slowly
    float k = clamp(aspect / 1.6, 0.5, 1.0);   // smaller figure on a tall screen
    float2 o = float2(aspect * (aspect < 1.0 ? 0.62 : 0.74) + sin(t * 0.4) * 0.04 * k, aspect < 1.0 ? 0.62 : 0.40);
    float2 p = (uv - o) / k;
    float sway = sin(t * 2.4) * 0.012;
    float torso = capsule(p, float2(0.0, -0.06), float2(0.0, 0.12), 0.085);
    float hips = capsule(p, float2(-0.04, 0.14), float2(0.04, 0.14), 0.06);
    float head = length(p - float2(0.0, -0.2)) - 0.055;
    float helmet = length((p - float2(0.0, -0.225)) * float2(1.0, 1.45)) - 0.07;
    float armL = capsule(p, float2(-0.085, -0.07), float2(-0.04, 0.05), 0.03);
    float armR = capsule(p, float2(0.085, -0.07), float2(0.15, 0.0), 0.03);
    float fore = capsule(p, float2(0.15, 0.0), float2(0.06, 0.02), 0.027);
    float legL = capsule(p, float2(-0.04, 0.17), float2(-0.05 - sway, 0.52), 0.04);
    float legR = capsule(p, float2(0.04, 0.17), float2(0.055 + sway, 0.52), 0.04);
    float body = min(min(min(torso, hips), min(head, armL)), min(min(armR, fore), min(legL, legR)));
    float rifle = min(capsule(p, float2(-0.05, 0.0), float2(0.3, -0.03), 0.012), capsule(p, float2(0.02, 0.0), float2(0.03, 0.07), 0.012));
    float heat = smoothstep(0.035, -0.04, body);
    heat = max(heat, smoothstep(0.03, -0.05, head) * 1.05);             // face runs hottest
    heat *= 1.0 - 0.35 * smoothstep(0.01, -0.02, helmet) * step(p.y, -0.2); // helmet reads cooler on top
    float halo = smoothstep(0.12, 0.0, body) * 0.25;
    // warm walls and vents in the background
    float bld = 0.06 * smoothstep(0.55, 0.75, uv.y) + 0.07 * smoothstep(0.03, 0.0, abs(fract(uv.x * 1.7 + 0.2) - 0.5) - 0.44) * smoothstep(0.25, 0.4, uv.y) * vnoise(uv * 8.0);
    float v = max(bg + bld, heat) + halo * (1.0 - heat);
    v = mix(v, 0.1, smoothstep(0.006, 0.0, rifle) * 0.85);
    float3 col = iron(v);
    col *= 0.85 + 0.15 * sin(fragCoord.y * 1.8);
    col += (hash21(fragCoord + floor(t * 24.0)) - 0.5) * 0.08;
    return half4(col, 1.0);
}
