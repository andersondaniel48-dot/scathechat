// Smoke screen: thick drifting smoke, lit from below by fire.
uniform float2 iResolution;
uniform float iTime;
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float t = iTime;
    float2 q = uv * 1.6 + float2(t * 0.04, -t * 0.02);
    float w = fbm(q + float2(fbm(q + t * 0.05), fbm(q * 1.3 - t * 0.03)) * 1.2);
    float dens = smoothstep(0.25, 0.75, w);
    float3 col = mix(float3(0.03, 0.028, 0.026), float3(0.34, 0.32, 0.30), dens);
    col *= 0.75 + 0.5 * fbm3(q * 4.0 + w);
    col += float3(0.6, 0.18, 0.04) * smoothstep(0.3, 1.0, uv.y) * (0.4 + 0.6 * dens) * 0.5;
    return half4(col, 1.0);
}
