// Shared noise and helpers for the Loadout shaders (AGSL; the preview tool converts it to GLSL).
float hash21(float2 p) { p = fract(p * float2(234.34, 435.345)); p += dot(p, p + 34.23); return fract(p.x * p.y); }
float2 hash22(float2 p) { float n = hash21(p); return float2(n, hash21(p + n * 17.0)); }
float vnoise(float2 p) {
    float2 i = floor(p); float2 f = fract(p); float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash21(i); float b = hash21(i + float2(1.0, 0.0)); float c = hash21(i + float2(0.0, 1.0)); float d = hash21(i + float2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(float2 p) { float v = 0.0; float a = 0.5; for (int i = 0; i < 6; i++) { v += a * vnoise(p); p = p * 2.03 + float2(17.1, 9.7); a *= 0.5; } return v; }
float fbm3(float2 p) { float v = 0.0; float a = 0.5; for (int i = 0; i < 3; i++) { v += a * vnoise(p); p = p * 2.03 + float2(17.1, 9.7); a *= 0.5; } return v; }
// distance to nearest feature point and the cell's random id
float3 voronoi(float2 p) {
    float2 n = floor(p); float2 f = fract(p); float md = 8.0; float2 id = float2(0.0);
    for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
        float2 g = float2(float(i), float(j)); float2 o = hash22(n + g); float2 r = g + o - f; float d = dot(r, r);
        if (d < md) { md = d; id = n + g; }
    }
    return float3(sqrt(md), hash21(id), hash21(id + 3.1));
}
float segDist(float2 p, float2 a, float2 b) { float2 pa = p - a; float2 ba = b - a; float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0); return length(pa - ba * h); }
float3 fireRamp(float t) {
    t = clamp(t, 0.0, 1.0);
    float3 c = mix(float3(0.0), float3(0.45, 0.02, 0.0), smoothstep(0.0, 0.25, t));
    c = mix(c, float3(0.95, 0.25, 0.02), smoothstep(0.2, 0.5, t));
    c = mix(c, float3(1.0, 0.72, 0.2), smoothstep(0.45, 0.75, t));
    return mix(c, float3(1.0, 0.97, 0.85), smoothstep(0.75, 1.0, t));
}
// Concrete: grime, pores, hairline cracks.
float3 concrete(float2 uv) {
    float g = 0.30 + 0.16 * fbm(uv * 6.0) + 0.07 * vnoise(uv * 120.0) - 0.06 * vnoise(uv * 35.0);
    float crack = abs(fbm(uv * 3.0 + 4.0) - 0.5);
    g -= 0.12 * smoothstep(0.012, 0.0, crack) * smoothstep(0.3, 0.6, vnoise(uv * 2.0));
    float stain = smoothstep(0.55, 0.85, fbm(uv * 2.2 + 9.0));
    return float3(g * 1.02, g * 0.97, g * 0.9) * (1.0 - 0.35 * stain);
}
// One thrown drop: a teardrop at p, travelling along u (tail points the way it flew).
float drop(float2 uv, float2 p, float2 u, float size, float stretch) {
    float2 q = uv - p; float along = dot(q, u); float across = dot(q, float2(-u.y, u.x));
    float e = (along / (size * stretch)) * (along / (size * stretch)) + (across / size) * (across / size);
    float head = smoothstep(1.0, 0.75, e);
    float tl = size * stretch * 2.2;
    float tw = size * 0.45 * (1.0 - clamp(along / tl, 0.0, 1.0));
    float tail = step(0.0, along) * step(along, tl) * smoothstep(tw, tw * 0.5, abs(across));
    return max(head, tail * 0.8);
}
// Blood spatter around c (radius r) flung along dir: a lobed wet pool, thrown drops that get smaller and
// longer with distance, a few long streaks, fine mist, and drips running down. Returns thickness 0..1.
float splat(float2 uv, float2 c, float r, float seed, float drip, float2 dir) {
    float2 d = uv - c; float len = length(d) + 1e-4; float2 n = d / len; float dist = len / r;
    float fwd = dot(n, dir);
    float lobes = vnoise(n * 1.7 + seed * 3.1);
    float detail = fbm3(n * 7.0 + seed * 1.3);
    float fine = vnoise(n * 24.0 + seed);
    float edge = 0.55 + 0.45 * lobes + 0.32 * detail + 0.06 * fine + 0.22 * max(fwd, 0.0);
    float body = smoothstep(edge, edge - 0.025, dist);
    float res = body * (0.55 + 0.45 * smoothstep(1.0, 0.1, dist / edge)) * (0.8 + 0.4 * fbm3(uv / r * 3.0 + seed));
    if (dist < 5.0) {
        float baseA = atan(dir.y, dir.x);
        for (int i = 0; i < 40; i++) {
            float fi = float(i);
            float h1 = hash21(float2(fi, seed)); float h2 = hash21(float2(seed, fi * 1.7)); float h3 = hash21(float2(fi * 2.3, seed + 5.0));
            float a = baseA + (h1 - 0.5) * (h3 < 0.15 ? 6.28 : 2.3);
            float2 u = float2(cos(a), sin(a));
            float far = pow(h2, 0.8);
            float2 p = c + u * r * (0.95 + far * 2.8);
            float size = r * (0.02 + 0.075 * (1.0 - far) * (0.4 + 0.6 * h3));
            res = max(res, drop(uv, p, u, size, 1.2 + far * 2.6) * 0.85);
        }
        // a few long streaks leaving the pool
        for (int k = 0; k < 4; k++) {
            float fk = float(k);
            float a = baseA + (hash21(float2(fk, seed + 9.0)) - 0.5) * 1.6;
            float2 u = float2(cos(a), sin(a));
            float2 p = c + u * r * 0.85;
            res = max(res, drop(uv, p, u, r * (0.035 + 0.02 * hash21(float2(seed, fk))), 4.0 + 3.0 * hash21(float2(fk, seed * 2.0))) * 0.75);
        }
    }
    // fine mist
    float3 m = voronoi(uv / r * 18.0 + seed * 3.0);
    float mist = smoothstep(edge, edge * 1.4, dist) * smoothstep(3.8, 1.2, dist) * (0.4 + 0.6 * max(fwd, 0.0));
    res = max(res, step(0.78, m.y) * smoothstep(0.17, 0.1, m.x) * mist * 0.7);
    // drips from the bottom of the pool
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float x = c.x + (fk - 1.0) * r * 0.36 + (hash21(float2(seed, fk)) - 0.5) * r * 0.18;
        float top = c.y + r * 0.45;
        float lenD = r * (0.6 + 1.8 * hash21(float2(fk, seed))) * drip;
        float w = r * (0.03 + 0.03 * hash21(float2(fk + 3.0, seed)));
        float dy = uv.y - top;
        float lane = smoothstep(w, w * 0.3, abs(uv.x - x + sin(dy * 40.0 + fk) * w * 0.3)) * step(0.0, dy) * step(dy, lenD);
        float bead = smoothstep(w * 1.8, w * 1.1, length(uv - float2(x, top + lenD)));
        res = max(res, max(lane, bead) * (1.0 - body) * 0.9);
    }
    return clamp(res, 0.0, 1.0);
}
// Shade a blood thickness field as wet: dark where thick, lighter at the thin edges, glossy highlights.
float3 shadeBlood(float3 under, float th, float dx, float dy) {
    float3 thin = float3(0.55, 0.03, 0.04);
    float3 thick = float3(0.16, 0.0, 0.01);
    float3 col = mix(thin, thick, smoothstep(0.1, 0.9, th));
    float3 n = normalize(float3(-dx * 3.0, -dy * 3.0, 1.0));
    float3 L = normalize(float3(-0.5, -0.7, 0.6));
    float spec = pow(max(dot(reflect(-L, n), float3(0.0, 0.0, 1.0)), 0.0), 28.0) * 1.3;
    float3 res = mix(under, col, smoothstep(0.02, 0.15, th));
    return res + spec * 0.9 * smoothstep(0.05, 0.3, th) + 0.04 * smoothstep(0.0, 0.5, th) * (1.0 - th);
}
