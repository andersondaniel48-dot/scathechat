// Glass jaw: a pane taking rounds. Spider-web cracks around each hit, refracting city lights behind.
uniform float2 iResolution;
uniform float iTime;
float3 scene(float2 uv) {
    float3 c = mix(float3(0.02, 0.03, 0.05), float3(0.05, 0.03, 0.06), uv.y);
    for (int i = 0; i < 14; i++) {
        float fi = float(i);
        float2 p = float2(3.2 * hash21(float2(fi, 1.0)), 0.2 + 0.7 * hash21(float2(fi, 2.0)));
        float3 lc = mix(float3(1.0, 0.55, 0.2), float3(0.3, 0.55, 1.0), hash21(float2(fi, 3.0)));
        c += lc * 0.06 / (0.02 + length(uv - p) * 6.0) * 0.4;
    }
    return c;
}
float2 crackField(float2 uv, float2 p, float s, float seed) {
    float2 d = uv - p; float r = length(d) / s; float a = atan(d.y, d.x);
    // radial cracks
    float spokes = 11.0 + floor(5.0 * hash21(float2(seed, 1.0)));
    float aa = a * spokes / 6.2832 + seed + 0.6 * vnoise(float2(r * 0.8, seed));
    float rad = smoothstep(0.06, 0.0, abs(fract(aa) - 0.5) * 2.0 * r * 0.18 - 0.002) * smoothstep(9.0, 1.0, r) * step(0.8, r);
    // concentric rings, broken
    float ringR = fract(log(max(r, 0.01)) * 2.2 + seed);
    float ring = smoothstep(0.06, 0.0, abs(ringR - 0.5) - 0.0) * step(0.45, vnoise(float2(a * 6.0, floor(log(max(r, 0.01)) * 2.2) + seed))) * smoothstep(7.0, 1.5, r) * step(1.0, r);
    float cell = hash21(float2(floor(aa), floor(log(max(r, 0.01)) * 2.2)) + seed);
    return float2(max(rad, ring * 0.7), cell);
}
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float aspect = iResolution.x / iResolution.y;
    float crack = 0.0; float2 offs = float2(0.0); float core = 0.0; float frost = 0.0;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float2 p = float2(aspect * (0.45 + 0.17 * fi), 0.3 + 0.4 * hash21(float2(fi, 8.0)));
        float s = 0.03 - 0.005 * fi;
        float2 cf = crackField(uv, p, s, fi * 3.7);
        crack = max(crack, cf.x);
        float r = length(uv - p) / s;
        offs += (cf.y - 0.5) * 0.02 * smoothstep(7.0, 1.0, r);
        core = max(core, smoothstep(0.7, 0.5, r));
        frost = max(frost, smoothstep(2.2, 0.6, r));
    }
    float3 col = scene(uv + offs);
    float sweep = fract(iTime * 0.08) * (aspect + 1.0) - 0.5;
    col += float3(0.6, 0.7, 0.8) * 0.06 * smoothstep(0.25, 0.0, abs(uv.x - sweep - uv.y * 0.4));
    col = mix(col, float3(0.75, 0.82, 0.9), crack * 0.75);
    col = mix(col, float3(0.6, 0.65, 0.7), frost * 0.5);
    col = mix(col, float3(0.0), core);
    return half4(col, 1.0);
}
