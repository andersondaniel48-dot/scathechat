// Interrogation room: blood on concrete, still wet, slowly running.
uniform float2 iResolution;
uniform float iTime;
// Positions scale with the aspect so the same scene works as a wide card and a tall chat background.
float field(float2 uv, float drip, float a) {
    float k = clamp(a / 2.0, 0.45, 1.0);
    float b = splat(uv, float2(a * 0.35, 0.40), 0.20 * k, 1.0, drip, normalize(float2(1.0, -0.35)));
    b = max(b, splat(uv, float2(a * 0.8, a < 1.0 ? 0.78 : 0.58), 0.13 * k, 4.0, drip * 0.8, normalize(float2(-0.8, -0.5))));
    b = max(b, splat(uv, float2(a * 0.107, a < 1.0 ? 0.15 : 0.70), 0.09 * k, 7.0, drip * 0.6, normalize(float2(0.3, -1.0))));
    return b;
}
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float drip = 0.55 + 0.45 * fract(iTime * 0.03);
    float e = 1.5 / iResolution.y;
    float a = iResolution.x / iResolution.y;
    float th = field(uv, drip, a);
    float dx = (field(uv + float2(e, 0.0), drip, a) - th) / e * 0.004;
    float dy = (field(uv + float2(0.0, e), drip, a) - th) / e * 0.004;
    float3 col = shadeBlood(concrete(uv * 1.3), th, dx, dy);
    // overhead lamp
    float2 c = float2(iResolution.x / iResolution.y * 0.55, -0.2);
    col *= 0.45 + 0.85 * smoothstep(1.6, 0.0, length(uv - c));
    return half4(col, 1.0);
}
